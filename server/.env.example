PORT=5000
# Local MongoDB, or your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/hirehub
# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Frontend URL(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173
NODE_ENV=development
